# Peer ranges like typescript@^5.9.3 (from graphql.web/multitars/csstype/toqr)
# clash with our root typescript@~6.0.3. Strict peer resolution makes npm 10
# demand a nested typescript@5.9.3 entry in the lock that npm 11 drops again —
# `npm ci` then fails on EAS/GitHub runners. Legacy mode keeps all npm versions
# consistent; peer version skew is harmless here (typescript is a build tool).
legacy-peer-deps=true
